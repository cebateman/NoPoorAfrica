rules_version = '2';

// Firestore Security Rules for No Poor Africa Dashboard
// Copy these rules into your Firebase Console > Firestore > Rules

service cloud.firestore {
  match /databases/{database}/documents {

    // App data (CSV files, dashboard settings): any authenticated user can read,
    // only admins can write
    match /appData/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles: any authenticated user can read (needed for role checks),
    // only admins can create/update/delete other users' profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      // Users can read their own profile
      // Admins can write any profile
      // New users can create their own profile (for first-time setup)
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
